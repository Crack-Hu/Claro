{
  "port": 3742,
  "verbose": false,
  "defaultMode": "claro",
  "llm": {
    "api_type": "openai-completions",
    "base_url": "https://api.deepseek.com",
    "api_key": "$CLARO_API_KEY",
    "model": "deepseek-v4-flash",
    "temperature": 0.3,
    "max_tokens": 4096,
    "reasoning_effort": "medium"
  },
  "modes": {
    "noop": {
      "enabled": true
    },
    "claro": {
      "enabled": true,
      "process_llm": {
        "thinking": { "type": "enabled" }
      },
      "finalize_llm": {
        "thinking": { "type": "enabled" }
      }
    },
    "translate": {
      "enabled": true
    }
  }
}
